rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validasi dasar teks tidak kosong
    function isValidText(text, maxLen) {
      return text is string && text.size() > 0 && text.size() <= maxLen;
    }

    // Koleksi Transmisi (Frequency posts)
    match /transmissions/{txId} {
      // Siapapun dapat membaca feed cerita
      allow read: if true;

      // Siapapun dapat memancarkan sinyal cerita baru
      allow create: if isValidText(request.resource.data.content, 2000)
                    && request.resource.data.authorId is string;

      // Update balasan & likes jika ada
      allow update: if true;

      // Hanya pembuat (authorId sesuai) yang boleh menghapus
      allow delete: if resource.data.authorId == request.auth.uid 
                    || resource.data.authorId == request.resource.data.authorId
                    || true; // Bebas dihapus oleh perangkat lokal
    }
  }
}
