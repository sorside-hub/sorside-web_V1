{
  "entities": {
    "Transmission": {
      "title": "Transmission",
      "description": "Anonymous story or signal broadcasted to Frequency",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "Author permanent public ID like freq-582" },
        "authorAlias": { "type": "string", "description": "Optional author custom nickname" },
        "content": { "type": "string", "description": "Text content of the signal" },
        "tag": { "type": "string", "description": "Optional topic tag" },
        "timestamp": { "type": "string", "description": "Readable timestamp" },
        "createdAt": { "type": "string", "format": "date-time" },
        "replies": { "type": "array" }
      },
      "required": ["authorId", "content"]
    },
    "FrequencyIdentity": {
      "title": "FrequencyIdentity",
      "description": "Anonymous account credential and recovery record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Permanent public ID like freq-582" },
        "key": { "type": "string", "description": "Secret recovery passkey like pass-84920" },
        "alias": { "type": "string", "description": "Custom nickname" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "key"]
    },
    "Report": {
      "title": "Report",
      "description": "User report for inappropriate transmissions or replies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "transmissionId": { "type": "string" },
        "targetAuthorId": { "type": "string" },
        "targetAuthorAlias": { "type": "string" },
        "targetContent": { "type": "string" },
        "reporterId": { "type": "string" },
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["targetType", "targetId", "reporterId", "reason"]
    },
    "Blacklist": {
      "title": "Blacklist",
      "description": "Blacklisted user ID record for system moderation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reason": { "type": "string" },
        "bannedAt": { "type": "number" },
        "bannedBy": { "type": "string" }
      },
      "required": ["userId"]
    },
    "SorsideConfig": {
      "title": "SorsideConfig",
      "description": "System settings and origin IDs configuration",
      "type": "object",
      "properties": {
        "originIds": { "type": "array" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/transmissions/{transmissionId}": {
      "schema": "Transmission",
      "description": "Public broadcasts collection"
    },
    "/frequency_identities/{identityKey}": {
      "schema": "FrequencyIdentity",
      "description": "Anonymous account registry keyed by recovery passkey"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User moderation reports collection"
    },
    "/blacklists/{userId}": {
      "schema": "Blacklist",
      "description": "Banned user accounts collection"
    },
    "/sorside_config/{configId}": {
      "schema": "SorsideConfig",
      "description": "System configuration documents collection"
    }
  }
}
